{
    "require": {
        "yahnis-elsts/plugin-update-checker": "^5"
    },
    "require-dev": {
        "pestphp/pest": "^3.5",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1",
        "php-stubs/wordpress-stubs": "^6.7",
        "bizbudding/deployable-guard": "^1"
    },
    "autoload": {
        "psr-4": {
            "Mai\\Popups\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mai\\Popups\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "stan": "phpstan analyse",
        "install-git-hooks": [
            "sh -c 'test -f vendor/bin/deployable-guard && php vendor/bin/deployable-guard install-hook || true'"
        ],
        "post-install-cmd": [
            "@install-git-hooks"
        ],
        "post-update-cmd": [
            "@install-git-hooks"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/bizbudding/deployable-guard"
        }
    ]
}
